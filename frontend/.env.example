# Development-only fallback when Django auth API is not running.
# Leave empty in integrated and production environments.
# Example for reports + online-chat local work:
# VITE_DEV_RBAC_ROLES=software_administrator,contact_center_analyst,contact_center_online_chat_operator
VITE_DEV_RBAC_ROLES=
# Proxy target must match infra BACKEND_PORT_HOST (compose default 8001).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8001
#
# Mock LDAP login for local admin APIs (KB create/upload, model params, …).
# Password MUST equal AUTH_MOCK_LDAP_DEFAULT_PASSWORD from infra/.env
# (compose/.env.example default is replace-with-dev-only-password).
# Copy these into frontend/.env.local (gitignored) after changing infra/.env.
# VITE_DEV_AUTH_USER=dev-role-01
# VITE_DEV_AUTH_PASSWORD=replace-with-dev-only-password

# Online-chat transcript e-mail (Django backend; optional for local Mailpit):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=1025
# ONLINE_CHAT_FROM_EMAIL=online-chat@belarusbank.by
