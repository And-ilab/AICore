# TEST / staging cutover for SUZ Model B (Bitrix → Sufler ingest).
# Copy to infra/test/.env and fill secrets before INT-T on the bank TEST VM.
# Spec: docs/integration/suz-bitrix-rag/tz-bitrix-rag-sufler.md (Model B, INT-09).

DJANGO_SECRET_KEY=replace-with-test-secret
DJANGO_DEBUG=false
# Host header of the public site (IP or DNS). Comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,ai-hub-test.bank.local
# Exact browser Origin of the SPA (scheme + host [+ port]). Required for chat POST/CSRF.
# Example: https://ai-hub-test.bank.local or https://10.0.0.12
DJANGO_CSRF_TRUSTED_ORIGINS=https://ai-hub-test.bank.local,https://127.0.0.1,https://localhost

# I.10 prod auth: real LDAPS (replaces P2-01 mock_ldap on TEST/PROD).
# Install: pip install -r backend/requirements-ldap.txt
AUTH_BACKEND=ldaps
AUTH_MODE=ldaps
AUTH_LDAP_SERVER_URI=ldaps://ad-test.bank.local:636
AUTH_LDAP_BIND_DN=CN=svc-sufler,OU=Service,DC=test,DC=asb
AUTH_LDAP_BIND_PASSWORD=replace-with-bind-password-from-vault
AUTH_LDAP_USER_SEARCH_BASE=OU=Users,DC=test,DC=asb
AUTH_LDAP_GROUP_SEARCH_BASE=OU=Groups,DC=test,DC=asb
AUTH_LDAP_USER_FILTER=(sAMAccountName=%(user)s)
AUTH_LDAP_TLS_CACERTFILE=/etc/ssl/certs/bank-ad-ca.pem
AUTH_LDAP_CACHE_TIMEOUT=300
# Optional overrides for VII.5.1 C2 (defaults = BB_* working matrix in auth/c2_groups.py).
# AUTH_LDAP_ROLE_GROUP_MAP_JSON={"ai_assistant_user":"BANK_APPROVED_ASSISTANT_USERS"}

AUTH_MOCK_LDAP_DEFAULT_PASSWORD=replace-with-dev-only-password

# --- SUZ / Bitrix Model B webhook (INT-01…08, INT-T-SUZ) ---
# mock = local unsigned webhook allowed when HMAC empty
# prod = HMAC secret REQUIRED; use for TEST/PROD cutover
SUZ_INGEST_MODE=prod
SUZ_WEBHOOK_PATH=/api/v1/knowledge/events
SUZ_WEBHOOK_HMAC_SECRET=replace-with-shared-suz-webhook-hmac-secret
# Optional allowlist of Bitrix iblock IDs (comma-separated). Empty = any.
SUZ_ALLOWED_IBLOCK_IDS=42

# --- INT-09 reconciliation polling fallback (Model B /changes) ---
# Bitrix custom module bank.sufler.sync exposes GET …/changes?since=&limit=
BITRIX_REST_BASE_URL=https://suz-test.bank.local
BITRIX_SERVICE_TOKEN=replace-with-bitrix-read-service-token
BITRIX_CHANGES_PATH=/local/api/sufler/v1/changes
BITRIX_HTTP_TIMEOUT_SECONDS=15
SUZ_RECONCILE_ENABLED=true
SUZ_RECONCILE_LIMIT=100
# Celery beat / cron interval hint (seconds); worker must schedule ingest.reconcile_suz_changes
SUZ_RECONCILE_INTERVAL_SECONDS=300

POSTGRES_DB=sufler
POSTGRES_USER=sufler
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
# Prod-like Compose does NOT publish postgres/redis/minio on the host.
# Host ports below are unused by docker-compose.prod-like.yml (kept for docs parity).
POSTGRES_PORT_HOST=5432

REDIS_PORT_HOST=6379
# Optional Redis AUTH on internal network (empty = no password).
REDIS_PASSWORD=

MINIO_ROOT_USER=sufler
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_API_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001
MINIO_OCR_BUCKET=sufler-ocr
# TEST prod-like forces MinIO for OCR originals/results (not local FS).
OCR_OBJECT_STORE_BACKEND=minio

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_CONCURRENCY=2

# Prod-like: public entry is edge nginx HTTPS (:443). Backend/frontend stay internal.
BACKEND_PORT_HOST=8000
FRONTEND_PORT_HOST=8080
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
# TLS files: infra/test/certs/fullchain.pem + privkey.pem (see gen-self-signed-cert.sh)

# Optional — set by CI `deploy.sh pull-up` (registry images). Leave empty for local --build.
# BACKEND_IMAGE=ghcr.io/example/sufler/backend:test-v1
# FRONTEND_IMAGE=ghcr.io/example/sufler/frontend:test-v1
# OLLAMA_IMAGE=ollama/ollama:latest
# EMBEDDING_IMAGE=ghcr.io/example/sufler/embedding:test-v1

AI_INFERENCE_PROFILE=test
# Empty = use deployment_profiles.test.llm.gateway_mode (stub).
MODEL_GATEWAY_MODE=
ASR_MODE=stub
ASR_HEALTH_URL=http://asr:8764/health
ASR_WS_URL=ws://asr:8765/

# CPU inference via Ollama (enable via: ./deploy.sh up --cpu-inference)
# COMPOSE_PROFILES=cpu-inference
# MODEL_GATEWAY_MODE=openai
# OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://ollama:11434
# OPENAI_TIMEOUT_SECONDS=600
# EMBEDDING_MODE=http
# EMBEDDING_BASE_URL=http://embedding:8090
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
# EMBEDDING_DIMENSIONS=1024

AUDIT_ENABLED=true
AUDIT_SINKS=file,kuma
# VI.3 prod KUMA HTTP collector (customer C5 / VII.5). Example shape only:
AUDIT_KUMA_COLLECTOR_URL=https://kuma-collector-test.bank.local/v1/events
AUDIT_HTTP_COLLECTOR_URL=
AUDIT_HTTP_TIMEOUT_SECONDS=5
AUDIT_DEVICE_VENDOR=Belarusbank
AUDIT_DEVICE_PRODUCT=AI_Hub
AUDIT_DEVICE_VERSION=0.1.0-test

# --- VI.2 Oktell TEST line T+45 (FR-SUF-04 / OKT-7 / P4-02) ---
# OKTELL_MODE=mock → local oktell_mock; prod → bank TEST WS endpoint below.
OKTELL_MODE=prod
OKTELL_ENABLED=true
OKTELL_MOCK_WS_URL=ws://127.0.0.1:8766
# Fill after ДИТ delivers TEST line (T+45). Example shape only:
OKTELL_PROD_WS_URL=wss://oktell-test.bank.local/ws
OKTELL_WS_URL=wss://oktell-test.bank.local/ws
OKTELL_SUBSCRIBE_EVENT=phoneevent
OKTELL_OPEN_TIMEOUT_SECONDS=10
OKTELL_PROFILE_ID=test_line_t45
OKTELL_TEST_LINE_LABEL=T+45 test line
OKTELL_TEST_QUEUE=replace-with-oktell-test-queue
OKTELL_TEST_MARKING=TEST_OKTELL_T45
OKTELL_LISTEN_MODE=mock
OKTELL_WEBHOOK_SECRET=
OKTELL_SIP_SERVER=10.1.1.31
OKTELL_SIP_DOMAIN=dev-qms.onedemoserver.online
OKTELL_SIP_PROXY=10.1.1.31
OKTELL_SIP_USER_START=2001
OKTELL_SIP_USER_COUNT=8
OKTELL_SIP_PASSWORD=
OKTELL_SIP_ACCOUNTS=
OKTELL_SIP_PASSWORDS_JSON=
OKTELL_SIP_BARGE=star
