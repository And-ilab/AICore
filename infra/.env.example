DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Browser Origin for SPA → Django CSRF (comma-separated).
# On the TEST VM add the exact Origin users open in the browser, e.g.:
# DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://YOUR_HOST:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8001,http://localhost:8001

# Development: AUTH_BACKEND=mock_ldap (P2-01). Prod I.10: AUTH_BACKEND=ldaps.
# AUTH_MODE is an alias kept for backward compatibility.
AUTH_BACKEND=mock_ldap
AUTH_MODE=mock_ldap
AUTH_MOCK_LDAP_DEFAULT_PASSWORD=replace-with-dev-only-password
# Prod SPA (FRONTEND_MODE=prod) bakes this password into the image for auto-login.
# Keep in sync with AUTH_MOCK_LDAP_DEFAULT_PASSWORD. Set VITE_ALLOW_DEV_LOGIN=0 for real LDAP.
# TEST: enable online-chat simulator + demo supervisor (baked into nginx frontend build).
VITE_SUFLER_DEMO=1

# --- SUZ Model B ingest (Bitrix → /api/v1/knowledge/events) ---
# mock: empty HMAC allowed for local INT-T. prod: HMAC required (see infra/test/.env.example).
SUZ_INGEST_MODE=mock
SUZ_WEBHOOK_PATH=/api/v1/knowledge/events
# SUZ Model B webhook HMAC. Empty is allowed only for local mock development.
SUZ_WEBHOOK_HMAC_SECRET=replace-with-a-shared-suz-webhook-secret
SUZ_ALLOWED_IBLOCK_IDS=

# INT-09 polling fallback (optional in mock; required for prod cutover).
BITRIX_REST_BASE_URL=
BITRIX_SERVICE_TOKEN=
BITRIX_CHANGES_PATH=/local/api/sufler/v1/changes
BITRIX_HTTP_TIMEOUT_SECONDS=15
SUZ_RECONCILE_ENABLED=false
SUZ_RECONCILE_LIMIT=100
SUZ_RECONCILE_INTERVAL_SECONDS=300

# VI.2 Oktell telephony. Default points at local oktell_mock (P1-14 / P4-02).
# OKTELL_MODE=mock|prod — prod uses TEST line T+45 profile (see infra/test/.env.example).
OKTELL_MODE=mock
OKTELL_ENABLED=false
OKTELL_WS_URL=ws://127.0.0.1:8766
OKTELL_MOCK_WS_URL=ws://127.0.0.1:8766
OKTELL_PROD_WS_URL=
OKTELL_SUBSCRIBE_EVENT=phoneevent
OKTELL_OPEN_TIMEOUT_SECONDS=5
OKTELL_PROFILE_ID=test_line_t45
OKTELL_TEST_LINE_LABEL=T+45 test line
OKTELL_TEST_QUEUE=
OKTELL_TEST_MARKING=TEST_OKTELL_T45
# Vendor pickup POST + SIP barge (02* client / 03* operator). Default mock glues to the sufler window.
OKTELL_LISTEN_MODE=mock
OKTELL_WEBHOOK_SECRET=
# Packet dest = Oktell Windows VM. Domain = SIP URI from vendor Excel.
OKTELL_SIP_SERVER=10.1.1.31
OKTELL_SIP_DOMAIN=dev-qms.onedemoserver.online
OKTELL_SIP_PROXY=10.1.1.31
# Public/VPN IP Oktell should reply to (docker NAT). Empty = autodetect.
OKTELL_SIP_LOCAL_IP=
OKTELL_SIP_USER_START=2001
OKTELL_SIP_USER_COUNT=8
OKTELL_SIP_PASSWORD=
OKTELL_SIP_ACCOUNTS=
OKTELL_SIP_PASSWORDS_JSON=
# star = Oktell 02*/03*. direct = dial CalledID as-is (Excel listen PBX).
OKTELL_SIP_BARGE=star
# 1 = treat 03* as client (phone). 0 = 02* client / 03* operator.
OKTELL_SIP_SWAP_SPEAKERS=

# VI.3 structured audit → KUMA (P2-05 schema_version=1.0 unchanged).
# Local: file only. Prod: file,kuma + AUDIT_KUMA_COLLECTOR_URL (see infra/test/.env.example).
AUDIT_ENABLED=true
AUDIT_SINKS=file
AUDIT_KUMA_COLLECTOR_URL=
AUDIT_HTTP_COLLECTOR_URL=
AUDIT_HTTP_TIMEOUT_SECONDS=5
AUDIT_DEVICE_VENDOR=Belarusbank
AUDIT_DEVICE_PRODUCT=AI_Hub

POSTGRES_DB=sufler
POSTGRES_USER=sufler
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_PORT_HOST=5432

REDIS_PORT_HOST=6379

MINIO_ROOT_USER=sufler
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_API_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001

BACKEND_PORT_HOST=8001
FRONTEND_PORT_HOST=5173

# Online-chat transcript e-mail (§4.4.28).
# Docker default: SMTP → Mailpit (UI http://localhost:8025).
# Without Mailpit (local manage.py): omit EMAIL_BACKEND → file backend in backend/var/mail.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=online-chat@belarusbank.by
ONLINE_CHAT_FROM_EMAIL=online-chat@belarusbank.by
MAILPIT_UI_PORT_HOST=8025
MAILPIT_SMTP_PORT_HOST=1025

# Online-chat attachments. Local fallback is backend/var/online-chat-objects;
# Docker uses the shared MinIO credentials declared above.
MINIO_ONLINE_CHAT_BUCKET=sufler-online-chat
ONLINE_CHAT_OBJECT_STORE_BACKEND=auto
ONLINE_CHAT_MAX_UPLOAD_BYTES=10485760
ONLINE_CHAT_ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,application/pdf,text/plain

# Text-channel adapters. Leave empty locally; supply secrets in the deployment
# secret store during bank TEST/prod cutover.
ONLINE_CHAT_CHANNEL_HTTP_TIMEOUT_SECONDS=10
ONLINE_CHAT_LOST_TIMEOUT_SECONDS=600
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Test contour: long polling (no HTTPS / ngrok). Service: telegram-poller.
TELEGRAM_MODE=polling
TELEGRAM_POLL_TIMEOUT_SECONDS=25
# Optional webhook (prod / ngrok): TELEGRAM_MODE=webhook and tools/set_telegram_webhook.py
VIBER_AUTH_TOKEN=
VK_ACCESS_TOKEN=
VK_WEBHOOK_SECRET=
VK_CONFIRMATION_CODE=
OK_ACCESS_TOKEN=
OK_WEBHOOK_SECRET=
ONLINE_CHAT_API_CHANNEL_SIGNING_SECRET=

# Dev-only: portal launcher roles when session is anonymous.
# Comma-separated I.4 role codes. Leave empty to hide launcher until login.
VITE_DEV_RBAC_ROLES=contact_center_online_chat_operator,contact_center_supervisor,contact_center_module_administrator,contact_center_telephony_operator,ai_hub_admin

# Local dev defaults to a lightweight stack (no Celery / embedding ML).
# EMBEDDING_MODE=stub
# Enable optional services only when you need them:
# COMPOSE_PROFILES=workers,telegram,embedding
# workers — Celery beat/worker (online-chat schedule + stale dialogs)
# telegram — long-polling bot (needs TELEGRAM_BOT_TOKEN)
# embedding — multilingual-e5-large (~1 GB RAM; set EMBEDDING_MODE=http)

# Qwen/Ollama for AI chat is paused. Chat and sufler share DeepSeek below.
# To bring Qwen back: clear SUFLER_LLM_* / ASSISTANT_LLM_* and restore Ollama.
# Optional CPU inference via Ollama (see infra/local-inference/README.md)
# Linux: ./local-inference/up-cpu.sh
# MODEL_GATEWAY_MODE=openai
# OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://ollama:11434
# OPENAI_TIMEOUT_SECONDS=600
# EMBEDDING_MODE=http
# EMBEDDING_BASE_URL=http://embedding:8090
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_MODELS_DIR=D:/sufler-models
# COMPOSE_PROFILES=cpu-inference
# Pull: docker compose --profile cpu-inference exec ollama ollama pull qwen2.5:3b

# Live Oktell ASR. Full Russian Vosk (~1.8 GB). If that folder is missing, code uses vosk-model-small-ru-0.22.
# VOSK_MODEL_PATH=/app/var/vosk-model-ru-0.42

# DeepSeek for sufler CC hints, AI chat, and OCR field structuring (same key).
SUFLER_LLM_BASE_URL=https://api.deepseek.com/v1
SUFLER_LLM_API_KEY=
SUFLER_LLM_MODEL=deepseek-chat
# Optional AI-chat override; empty = same as SUFLER_LLM_*.
# ASSISTANT_LLM_BASE_URL=https://api.deepseek.com/v1
# ASSISTANT_LLM_API_KEY=
# ASSISTANT_LLM_MODEL=deepseek-chat
# Optional OCR override; empty = same DeepSeek as SUFLER_LLM_*.
# OCR_LLM_BASE_URL=https://api.deepseek.com/v1
# OCR_LLM_API_KEY=
# OCR_LLM_MODEL=deepseek-chat
# Without SUZ articles, still ask DeepSeek (default in docker-compose is 1).
SUFLER_ALLOW_UNGROUNDED=1
