    {
      "name": "ocr",
      "item": [
        {
          "name": "Enqueue OCR job (multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "description": "Optional bearer"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ocr/jobs/",
              "protocol": "http",
              "host": [
                "{{base_host}}"
              ],
              "port": "{{base_port}}",
              "path": [
                "api",
                "v1",
                "ocr",
                "jobs"
              ],
              "query": []
            },
            "description": "Upload a scan (pdf/jpg/png/tiff). Pass `doc_type` with `mode=template`, or `mode=ml` for auto-detect. Requires `ocr.use`. Async only — poll GET /jobs/{id}/.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "",
                  "src": ""
                },
                {
                  "key": "doc_type",
                  "type": "text",
                  "description": "Document type / template id",
                  "value": "passport"
                },
                {
                  "key": "document_type",
                  "type": "text",
                  "description": "Alias for doc_type",
                  "value": ""
                },
                {
                  "key": "mode",
                  "type": "text",
                  "description": "template requires doc_type; ml auto-detects type",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "OCR job status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "description": "Optional bearer"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ocr/jobs/{id}/",
              "protocol": "http",
              "host": [
                "{{base_host}}"
              ],
              "port": "{{base_port}}",
              "path": [
                "api",
                "v1",
                "ocr",
                "jobs",
                ":id"
              ],
              "query": []
            },
            "description": "status, progress (0–100), error. Requires `ocr.use`."
          }
        },
        {
          "name": "Approve / edit OCR fields (optional stub)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "description": "Optional bearer"
