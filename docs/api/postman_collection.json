              "host": [
                "{{base_host}}"
              ],
              "port": "{{base_port}}",
              "path": [
                "api",
                "v1",
                "ocr",
                "jobs",
                ":id",
                "result"
              ],
              "query": []
            },
            "description": "Structured fields with confidence. 409 if the job is not completed."
          }
        }
