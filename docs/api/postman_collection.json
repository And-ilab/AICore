              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Sufler-Event-Id",
                "value": "",
                "description": "Must match body event_id when present"
              },
              {
                "key": "X-Sufler-Signature",
                "value": "{{suz_hmac_signature}}",
                "description": "HMAC-SHA256(raw body, shared secret)"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/knowledge/events",
              "protocol": "http",
              "host": [
                "{{base_host}}"
              ],
              "port": "{{base_port}}",
              "path": [
                "api",
                "v1",
                "knowledge",
                "events"
              ],
              "query": []
            },
            "description": "HMAC required when `SUZ_WEBHOOK_HMAC_SECRET` is set. In `SUZ_INGEST_MODE=prod` the secret is mandatory.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
