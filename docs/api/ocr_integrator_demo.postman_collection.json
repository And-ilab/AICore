    {
      "name": "2. GET Статус задания",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/api/v1/ocr/jobs/{{job_id}}/",
        "description": "Жмите Send, пока status=completed и progress=100. Потом шаг 3. 409 на шаге 3 = ещё рано."
      }
    },
    {
      "name": "3. GET Результат полей",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  if (body.document_type) { pm.collectionVariables.set('document_type', body.document_type); }",
              "  const raw = body.fields || {};",
              "  const fields = {};",
              "  Object.keys(raw).forEach(function (key) {",
              "    const v = raw[key];",
              "    fields[key] = (v && typeof v === 'object' && 'value' in v) ? v.value : v;",
              "  });",
              "  if (Object.keys(fields).length) {",
              "    pm.collectionVariables.set('approve_fields', JSON.stringify(fields, null, 2));",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/api/v1/ocr/jobs/{{job_id}}/result/",
        "description": "200 = поля. 409 not_ready = вернитесь на шаг 2."
      }
    },
    {
      "name": "4. POST Утвердить поля",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"document_type\": \"{{document_type}}\",\n  \"fields\": {{approve_fields}}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/v1/ocr/jobs/{{job_id}}/approve/",
        "description": "После шага 3 тело подставится само. 200 = approved."
      }
    }
