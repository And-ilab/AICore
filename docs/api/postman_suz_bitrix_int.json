{
  "info": {
    "name": "Sufler SUZ Bitrix INT (TZ Model B)",
    "description": "Имитация Bitrix → Sufler по ТЗ (INT-01…10).\n\nВАЖНО про auth:\n1) Переимпортируй ЭТУ версию файла (старая ломала HMAC).\n2) Variables → suz_hmac_secret = replace-with-a-shared-suz-webhook-secret (как в infra/.env)\n3) Body — одна строка JSON, не форматируй Beautify — иначе подпись сломается.\n4) INT-07c специально даёт {\"error\":\"auth\"}.\n\nУспех webhook: 202. 503 = нет Redis/Celery.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "sufler-suz-bitrix-int-tz-v2"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "suz_hmac_secret", "value": "replace-with-a-shared-suz-webhook-secret" },
    { "key": "bitrix_base_url", "value": "http://bitrix.test.local" },
    { "key": "bitrix_service_token", "value": "replace-with-bitrix-service-token" }
  ],
  "item": [
    {
      "name": "00 Helpers (вспомогательные)",
      "description": "Проверка стенда и сторона Суфлёра для INT-09.",
      "item": [
        {
          "name": "H-01 Health — backend alive",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/client-info/",
            "description": "Жив ли backend :8000. Ожидание 200."
          }
        },
        {
          "name": "H-02 INT-09 — reconcile status (Sufler)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/knowledge/reconcile/",
            "description": "Курсор INT-09 на Суфлёре. Ожидание 200."
          }
        },
        {
          "name": "H-03 INT-09 — reconcile run (Sufler)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/knowledge/reconcile/run/",
            "description": "Запуск poll /changes (mock без Bitrix). Ожидание 200."
          }
        }
      ]
    },
    {
      "name": "INT Bitrix → Sufler (webhook)",
      "description": "POST /api/v1/knowledge/events. Подписи HMAC уже вставлены под секрет из infra/.env. Не жми Beautify на Body.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const CryptoJS = require('crypto-js');",
              "const name = pm.info.requestName || '';",
              "if (name.indexOf('INT-07c') >= 0) { return; }",
              "if (!pm.request.body || !pm.request.body.raw) { return; }",
              "const raw = pm.request.body.raw;",
              "let data;",
              "try { data = JSON.parse(raw); } catch (e) { console.warn('bad json'); return; }",
              "if (data.event_id) {",
              "  pm.request.headers.upsert({ key: 'X-Sufler-Event-Id', value: String(data.event_id) });",
              "}",
              "const secret = pm.collectionVariables.get('suz_hmac_secret') || pm.variables.get('suz_hmac_secret') || '';",
              "if (!secret) {",
              "  console.warn('suz_hmac_secret empty — backend вернёт auth если секрет задан');",
              "  return;",
              "}",
              "const sig = CryptoJS.HmacSHA256(raw, secret).toString();",
              "pm.request.headers.upsert({ key: 'X-Sufler-Signature', value: sig });",
              "console.log('signed', name, 'sig', sig.slice(0, 12));"
            ]
          }
        }
      ],
