        "body": {
          "mode": "raw",
          "raw": "{\n  \"document_type\": \"{{document_type}}\",\n  \"fields\": {{approve_fields}}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/v1/ocr/jobs/{{job_id}}/approve/",
        "description": "После долгого шага 3. По желанию."
      }
