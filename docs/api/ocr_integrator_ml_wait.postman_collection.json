    {
      "name": "2. GET Статус (по желанию)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/api/v1/ocr/jobs/{{job_id}}/",
        "description": "Можно не жать. Для показа долгой загрузки используйте сразу шаг 3."
      }
    },
    {
      "name": "3. GET Результат (ждёт OCR, долго)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jobId = pm.collectionVariables.get('job_id');",
              "const base = pm.collectionVariables.get('base_url');",
              "function delay(ms) {",
              "  return new Promise(function (resolve) { setTimeout(resolve, ms); });",
              "}",
              "async function waitForOcr() {",
              "  const deadline = Date.now() + 180000;",
              "  while (Date.now() < deadline) {",
              "    const res = await new Promise(function (resolve, reject) {",
              "      pm.sendRequest({",
              "        url: base + '/api/v1/ocr/jobs/' + jobId + '/',",
              "        method: 'GET',",
              "        header: [{ key: 'Accept', value: 'application/json' }]",
              "      }, function (err, response) {",
              "        if (err) reject(err); else resolve(response);",
              "      });",
              "    });",
              "    let status = '';",
              "    try { status = res.json().status || ''; } catch (e) {}",
              "    console.log('OCR ещё работает:', status);",
              "    if (status === 'completed' || status === 'processing_error') return;",
              "    await delay(2500);",
              "  }",
              "}",
              "await waitForOcr();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  if (body.document_type) pm.collectionVariables.set('document_type', body.document_type);",
              "  const raw = body.fields || {};",
              "  const fields = {};",
              "  Object.keys(raw).forEach(function (key) {",
              "    const v = raw[key];",
              "    fields[key] = (v && typeof v === 'object' && 'value' in v) ? v.value : v;",
              "  });",
              "  if (Object.keys(fields).length) {",
              "    pm.collectionVariables.set('approve_fields', JSON.stringify(fields, null, 2));",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/api/v1/ocr/jobs/{{job_id}}/result/",
        "description": "Перед самим GET скрипт ждёт, пока status=completed (до 3 минут). Поэтому кнопка Send крутится долго — это и есть демо. Потом 200 и fields. 409 сюда почти не попадёт."
      }
    },
